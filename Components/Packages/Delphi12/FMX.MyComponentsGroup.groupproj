    </Target>
    <Target Name="FMX_dclMyComponents:Clean">
        <MSBuild Projects="FMX.dclMyComponents.dproj" Targets="Clean"/>
    </Target>
    <Target Name="FMX_dclMyComponents:Make">
        <MSBuild Projects="FMX.dclMyComponents.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="FMX_MyComponents;FMX_dclMyComponents"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="FMX_MyComponents:Clean;FMX_dclMyComponents:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="FMX_MyComponents:Make;FMX_dclMyComponents:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
